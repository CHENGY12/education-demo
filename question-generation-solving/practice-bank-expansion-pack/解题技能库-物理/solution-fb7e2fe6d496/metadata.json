{
  "action": "create",
  "applicability": [
    "双棒或多棒电磁耦合",
    "求总焦耳热或分棒发热",
    "求安培力功",
    "无外力阶段求共同末速"
  ],
  "description": "对多导体闭合回路分层处理外力功、总动能、焦耳热及单个导体的安培力功。",
  "generalized": true,
  "name": "耦合导体电磁过程的整体—个体双层账本",
  "novel": true,
  "novelty_rationale": "现有技能未覆盖耦合机电系统的整体与局部账本。",
  "ordered_steps": [
    "划定整体边界并判断沿运动方向是否存在外力。",
    "无外力阶段可用系统动量守恒求共同速度；有外力时不擅用动量守恒。",
    "对整体写外力总功等于总动能增量与总焦耳热之和。",
    "对单根导体写动能定理，分离该棒的外力功和安培力功。",
    "同一串联回路各处电流相同，故全过程热量按电阻比分配。",
    "用各棒安培力功代数和等于总焦耳热的相反数复核。"
  ],
  "pitfalls": [
    "某棒安培力功不等于该棒自身发热",
    "电磁内力做功代数和通常不为零",
    "持续外力阶段不能机械套动量守恒"
  ],
